# NEAR AI Cloud — required
# Get a key at https://cloud.near.ai (Credits → API Keys)
NEARAI_CLOUD_API_KEY=

# A TEE-hosted model owned by "nearai" in GET /v1/models
NEARAI_MODEL=Qwen/Qwen3.8-27B

# Optional overrides
NEARAI_CLOUD_BASE_URL=https://cloud-api.near.ai

# Public repository URL shown in the header/footer (optional)
NEXT_PUBLIC_REPO_URL=

# Public site URL used for absolute Open Graph / Twitter image URLs (optional)
NEXT_PUBLIC_SITE_URL=
